# Copy this file to .env (git-ignored) before running docker compose. Values
# below are local-dev placeholders, not secrets meant to survive beyond a
# single-user dev machine — see docs/assumptions-register.md (A7, A9) and
# docs/security-and-threat-model.md. Replace all of them before any shared
# or deployed environment.

POSTGRES_USER=jme
POSTGRES_PASSWORD=jme_dev_password
POSTGRES_DB=jme
MLFLOW_DB_NAME=mlflow

# API-key auth for the matching endpoints (X-API-Key header). See
# docs/security-and-threat-model.md for what this does/doesn't protect
# against.
JME_API_KEY=dev-local-key-change-me

# Grafana admin password (Phase 9 observability). Anonymous viewer access is
# also enabled for local convenience (GF_AUTH_ANONYMOUS_ENABLED in
# docker-compose.yml) - the admin password only matters for making changes.
GRAFANA_ADMIN_PASSWORD=dev-local-password-change-me

# Neo4j admin password (Phase 19 knowledge graph). See docs/knowledge-graph.md.
NEO4J_PASSWORD=dev-local-password-change-me

# CV upload object storage (SeaweedFS's S3-compatible API). See
# docs/skill-extraction.md "CV upload storage".
CV_STORAGE_ACCESS_KEY=dev-local-key-change-me
CV_STORAGE_SECRET_KEY=dev-local-secret-change-me
