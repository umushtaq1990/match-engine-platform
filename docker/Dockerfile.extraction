# Use Case C's extraction service (Phase 16). Independent of
# docker/Dockerfile.api and docker/Dockerfile.analytics — no model weights
# live here, it calls the shared `ollama` service over HTTP. See
# docs/skill-extraction.md "Service boundary".
FROM python:3.12-slim

WORKDIR /app

COPY app/requirements-base.txt app/requirements-extraction.txt ./
RUN pip install --no-cache-dir -r requirements-extraction.txt

COPY app/db.py ./app/db.py
COPY app/__init__.py ./app/__init__.py
COPY app/ingestion/__init__.py ./app/ingestion/__init__.py
COPY app/ingestion/source_models.py ./app/ingestion/source_models.py
COPY app/extraction/ ./app/extraction/
COPY app/embeddings/ ./app/embeddings/
COPY data/golden/ ./data/golden/

EXPOSE 8002

CMD ["uvicorn", "app.extraction.main:app", "--host", "0.0.0.0", "--port", "8002"]
