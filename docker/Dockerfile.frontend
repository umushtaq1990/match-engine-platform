# Phase 27's demo frontend — a thin HTTP client over the api/extraction
# services, nothing else. Deliberately the smallest image in this project:
# no app/db.py, no app/matching, no ORM at all — it never touches Postgres
# directly, only the existing APIs over HTTP. See docs/frontend.md.
FROM python:3.12-slim

WORKDIR /app

COPY app/requirements-frontend.txt ./
RUN pip install --no-cache-dir -r requirements-frontend.txt

COPY app/__init__.py ./app/__init__.py
COPY app/common/ ./app/common/
COPY app/frontend/ ./app/frontend/

# `streamlit run app/frontend/streamlit_app.py` doesn't put /app on sys.path
# the way `uvicorn app.api.main:app` does for the other services (no module
# import happens) — needed for Phase 30's `app.common` import.
ENV PYTHONPATH=/app

EXPOSE 8501

CMD ["streamlit", "run", "app/frontend/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
