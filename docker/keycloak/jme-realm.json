{
  "realm": "jme",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "roles": {
    "realm": [
      {"name": "candidate", "description": "Can upload a CV and view job matches"},
      {"name": "employer", "description": "Can view candidate matches for a job"}
    ]
  },
  "clients": [
    {
      "clientId": "jme-frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:8080/*", "http://localhost:8501/*"],
      "webOrigins": ["*"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "realm roles (ID token)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "jme-admin",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "dev-local-admin-client-secret-change-me"
    }
  ],
  "users": [
    {
      "username": "candidate",
      "enabled": true,
      "emailVerified": true,
      "email": "candidate@example.com",
      "firstName": "Demo",
      "lastName": "Candidate",
      "credentials": [
        {"type": "password", "value": "candidate-dev-pw", "temporary": false}
      ],
      "realmRoles": ["candidate"]
    },
    {
      "username": "employer",
      "enabled": true,
      "emailVerified": true,
      "email": "employer@example.com",
      "firstName": "Demo",
      "lastName": "Employer",
      "credentials": [
        {"type": "password", "value": "employer-dev-pw", "temporary": false}
      ],
      "realmRoles": ["employer"]
    },
    {
      "username": "service-account-jme-admin",
      "enabled": true,
      "serviceAccountClientId": "jme-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "view-realm"]
      }
    }
  ]
}
