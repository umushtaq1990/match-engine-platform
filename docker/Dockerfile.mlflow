# MLflow tracking server: always-on service (like api/db), not a one-off job -
# its UI/API must be reachable at any time to browse past experiment runs.
FROM python:3.15-slim

WORKDIR /app

RUN pip install --no-cache-dir mlflow==3.17.2 psycopg2-binary==2.9.9

EXPOSE 5000

# Backend store URI comes from the MLFLOW_BACKEND_STORE_URI env var (set in
# docker-compose.yml from .env) rather than being baked in here — shell form
# so it's expanded at container start, not image build time.
# --allowed-hosts: MLflow 3.x's default (localhost + private IPs) rejects
# every internal request made via the Docker service name "mlflow" (a
# hostname, not localhost or an IP) with "Invalid Host header - possible
# DNS rebinding attack detected" -- confirmed live, every extraction eval
# run all session silently failed to log here for exactly this reason (the
# eval itself still succeeded; _log_to_mlflow is deliberately best-effort).
# Scoped to the exact hostname other services actually use, not '*'.
CMD mlflow server \
    --backend-store-uri "$MLFLOW_BACKEND_STORE_URI" \
    --default-artifact-root /mlflow-artifacts \
    --host 0.0.0.0 --port 5000 \
    --allowed-hosts "mlflow,mlflow:5000,localhost,localhost:5000"
