FROM python:3.12-slim

WORKDIR /app

COPY app/requirements-base.txt app/requirements-migrate.txt ./
RUN pip install --no-cache-dir -r requirements-migrate.txt

COPY app/db.py ./app/db.py
COPY app/__init__.py ./app/__init__.py
COPY app/ingestion/source_models.py ./app/ingestion/source_models.py
COPY app/ingestion/quality_models.py ./app/ingestion/quality_models.py
COPY app/ingestion/__init__.py ./app/ingestion/__init__.py
COPY app/evaluation/eval_models.py ./app/evaluation/eval_models.py
COPY app/evaluation/__init__.py ./app/evaluation/__init__.py
COPY app/analytics/models.py ./app/analytics/models.py
COPY app/analytics/__init__.py ./app/analytics/__init__.py
COPY alembic.ini ./alembic.ini
COPY alembic/ ./alembic/

CMD ["python", "-m", "alembic", "upgrade", "head"]
