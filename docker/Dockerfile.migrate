FROM python:3.12-slim

WORKDIR /app

COPY app/requirements-base.txt app/requirements-migrate.txt ./
RUN pip install --no-cache-dir -r requirements-migrate.txt

COPY app/db.py ./app/db.py
COPY app/__init__.py ./app/__init__.py
COPY app/common/ ./app/common/
COPY app/ingestion/source_models.py ./app/ingestion/source_models.py
COPY app/ingestion/quality_models.py ./app/ingestion/quality_models.py
COPY app/ingestion/__init__.py ./app/ingestion/__init__.py
COPY app/evaluation/eval_models.py ./app/evaluation/eval_models.py
COPY app/evaluation/__init__.py ./app/evaluation/__init__.py
COPY app/analytics/models.py ./app/analytics/models.py
COPY app/analytics/__init__.py ./app/analytics/__init__.py
COPY app/extraction/models.py ./app/extraction/models.py
COPY app/extraction/__init__.py ./app/extraction/__init__.py
COPY app/embeddings/models.py ./app/embeddings/models.py
COPY app/embeddings/__init__.py ./app/embeddings/__init__.py
COPY app/clustering/models.py ./app/clustering/models.py
COPY app/clustering/__init__.py ./app/clustering/__init__.py
COPY app/identity/models.py ./app/identity/models.py
COPY app/identity/__init__.py ./app/identity/__init__.py
COPY app/audit/models.py ./app/audit/models.py
COPY app/audit/__init__.py ./app/audit/__init__.py
COPY app/golden/models.py ./app/golden/models.py
COPY app/golden/__init__.py ./app/golden/__init__.py
COPY app/chatbot/models.py ./app/chatbot/models.py
COPY app/chatbot/__init__.py ./app/chatbot/__init__.py
COPY alembic.ini ./alembic.ini
COPY alembic/ ./alembic/

CMD ["python", "-m", "alembic", "upgrade", "head"]
